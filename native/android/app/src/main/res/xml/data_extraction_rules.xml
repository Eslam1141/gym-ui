<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup and no device-to-device transfer of the session vault. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="etq_session_vault.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="etq_session_vault.xml" />
    </device-transfer>
</data-extraction-rules>
